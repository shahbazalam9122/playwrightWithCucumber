{
  "default": {
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "paths": [
      "src/tests/features/addToCart.feature"
    ],
    "require": [
      "src/tests/steps/*.ts",
      "src/hooks/hooks.ts"
    ],
    "requireModule": ["ts-node/register"],
    "format":[
      "progress-bar",
      "html:test-results/cucumber-report.html",
      "json:test-results/cucumber-report.json",
      "rerun:@rerun.txt"
    ],
    "publishQuiet": true,
    "parallel":2,
    "dryRun": false
  },
  "rerun": {
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "require": [
      "src/tests/steps/*.ts",
      "src/hooks/hooks.ts"
    ],
    "requireModule": ["ts-node/register"],
    "format":[
      "progress-bar",
      "html:test-results/cucumber-report.html",
      "json:test-results/cucumber-report.json",
      "rerun:@rerun.txt"
    ],
    "publishQuiet": true,
    "parallel":2,
    "dryRun": false
  }
}